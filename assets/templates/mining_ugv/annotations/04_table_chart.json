{
  "template_id": "04_table_chart",
  "template_name": "Table + Chart",
  "version": "1.0",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "aspect_ratio": "16:9"
  },
  "background": {
    "asset": "bg_01.png",
    "type": "image"
  },
  "safe_area": {
    "x": 83,
    "y": 48,
    "width": 1754,
    "height": 984
  },
  "regions": {
    "left_column": {
      "type": "container",
      "role": "chart_column",
      "geometry": "fixed",
      "x": 105,
      "y": 75,
      "width": 790,
      "height": 850
    },
    "right_column": {
      "type": "container",
      "role": "table_information_column",
      "geometry": "fixed",
      "x": 945,
      "y": 75,
      "width": 790,
      "height": 850
    },
    "context_note": {
      "type": "text",
      "role": "chart_context",
      "geometry": "dynamic",
      "x": 105,
      "y": 75,
      "width": 790,
      "height": 75,
      "allow_wrap": true
    },
    "chart": {
      "type": "chart",
      "role": "primary_chart",
      "geometry": "dynamic",
      "x": 135,
      "y": 185,
      "width": 750,
      "height": 570,
      "constraints": {
        "minimum_width": 600,
        "minimum_height": 400,
        "preserve_aspect_ratio": true
      }
    },
    "section_heading": {
      "type": "text",
      "role": "content_heading",
      "geometry": "dynamic",
      "x": 960,
      "y": 75,
      "width": 730,
      "height": 55,
      "allow_wrap": true,
      "maximum_lines": 2
    },
    "narrative": {
      "type": "text",
      "role": "content_narrative",
      "geometry": "dynamic",
      "x": 960,
      "y": 130,
      "width": 730,
      "height": 115,
      "allow_wrap": true,
      "maximum_lines": 5
    },
    "table": {
      "type": "table",
      "role": "analytical_table",
      "geometry": "dynamic",
      "x": 960,
      "y": 250,
      "width": 730,
      "height": 370,
      "layout": {
        "columns": "dynamic",
        "rows": "dynamic",
        "auto_row_height": true,
        "auto_column_width": true
      }
    },
    "supporting_insight": {
      "type": "text",
      "role": "supporting_insight",
      "geometry": "dynamic",
      "x": 960,
      "y": 640,
      "width": 730,
      "height": 130,
      "allow_wrap": true
    }
  },
  "components": {},
  "typography": {
    "context_note": {
      "font_size": 20,
      "minimum_font_size": 17,
      "maximum_font_size": 21,
      "font_weight": "normal"
    },
    "section_heading": {
      "font_size": 25,
      "minimum_font_size": 21,
      "maximum_font_size": 27,
      "font_weight": "bold"
    },
    "narrative": {
      "font_size": 21,
      "minimum_font_size": 17,
      "maximum_font_size": 22,
      "font_weight": "normal"
    },
    "table": {
      "font_size": 18,
      "minimum_font_size": 14,
      "maximum_font_size": 19
    },
    "supporting_insight": {
      "font_size": 19,
      "minimum_font_size": 16,
      "maximum_font_size": 20
    }
  },
  "spacing": {
    "column_gap": 45,
    "context_to_chart": 25,
    "heading_to_narrative": 8,
    "narrative_to_table": 15,
    "table_to_insight": 25
  },
  "constraints": {
    "layout": {
      "two_column": true,
      "preserve_column_alignment": true,
      "preserve_chart_table_balance": true
    },
    "chart": {
      "minimum_width": 600,
      "minimum_height": 400,
      "allow_resize": true
    },
    "table": {
      "auto_row_height": true,
      "auto_column_width": true,
      "allow_text_wrap": true,
      "allow_font_reduction": true,
      "allow_split": true,
      "minimum_font_size": 14
    },
    "text": {
      "allow_wrap": true,
      "prevent_clipping": true
    }
  },
  "overflow": {
    "strategy": [
      "measure_text",
      "resize_dynamic_regions",
      "reduce_internal_spacing",
      "reduce_font_size_within_limits",
      "resize_table_rows",
      "resize_chart",
      "move_supporting_content_to_continuation_slide",
      "split_table_if_required"
    ],
    "never": [
      "crop_text",
      "overlap_regions",
      "shrink_below_minimum_font_size",
      "reduce_chart_below_minimum_dimensions"
    ]
  },
  "content_model": {
    "type": "table_chart",
    "required": [
      "chart",
      "table"
    ],
    "properties": {
      "context_note": {
        "type": "string"
      },
      "section_heading": {
        "type": "string"
      },
      "narrative": {
        "type": "string"
      },
      "chart": {
        "type": "chart"
      },
      "table": {
        "type": "table"
      },
      "supporting_insight": {
        "type": "string"
      }
    }
  }
}