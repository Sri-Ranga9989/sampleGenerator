{
  "template_id": "03_section_opener",
  "template_name": "Section Opener",
  "version": "1.0",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "aspect_ratio": "16:9"
  },
  "background": {
    "asset": "bg_01.png",
    "type": "image"
  },
  "safe_area": {
    "x": 83,
    "y": 48,
    "width": 1810,
    "height": 930
  },
  "regions": {
    "section_title": {
      "type": "text",
      "role": "section_title",
      "geometry": "fixed_anchor",
      "x": 105,
      "y": 80,
      "width": 1150,
      "height": 110,
      "alignment": "left",
      "vertical_alignment": "top",
      "allow_wrap": true,
      "maximum_lines": 2
    },
    "index_list": {
      "type": "container",
      "role": "section_index_list",
      "geometry": "dynamic",
      "x": 105,
      "y": 220,
      "width": 1150,
      "height": 590,
      "layout": {
        "type": "vertical_stack",
        "item_type": "index_item",
        "items": "dynamic"
      }
    },
    "visual_region": {
      "type": "image",
      "role": "section_visual",
      "geometry": "fixed",
      "x": 1015,
      "y": 0,
      "width": 905,
      "height": 930,
      "content_behavior": {
        "allow_text": false,
        "allow_overlap": false
      }
    }
  },
  "components": {
    "index_item": {
      "type": "component",
      "role": "index_item",
      "number": {
        "type": "text",
        "width": 65,
        "alignment": "left"
      },
      "title": {
        "type": "text",
        "x_offset": 0,
        "alignment": "left",
        "allow_wrap": true,
        "maximum_lines": 2
      }
    }
  },
  "typography": {
    "section_title": {
      "font_weight": "bold",
      "font_size": 40,
      "minimum_font_size": 32,
      "maximum_font_size": 44,
      "line_spacing": 0.95
    },
    "index_item": {
      "font_weight": "normal",
      "font_size": 21,
      "minimum_font_size": 17,
      "maximum_font_size": 22,
      "line_spacing": 1.05
    }
  },
  "spacing": {
    "title_to_index_list": 25,
    "index_item_gap": 10,
    "minimum_index_item_gap": 4
  },
  "constraints": {
    "preferred_index_items": 15,
    "maximum_index_items": 15,
    "index_item": {
      "preferred_lines": 1,
      "maximum_lines": 2
    },
    "layout": {
      "preserve_visual_region": true,
      "preserve_title_hierarchy": true,
      "preserve_left_alignment": true
    }
  },
  "overflow": {
    "strategy": [
      "wrap_index_item",
      "reduce_index_spacing",
      "reduce_index_font_size",
      "calculate_remaining_capacity",
      "move_remaining_index_items_to_information_slide"
    ],
    "continuation_template": "05_insight_information",
    "continuation_layout": "multi_column_index_list",
    "never": [
      "crop_index_text",
      "overlap_index_items",
      "extend_into_visual_region",
      "shrink_below_minimum_font_size"
    ]
  },
  "content_model": {
    "type": "section_opener",
    "required": [
      "section_number",
      "section_title"
    ],
    "properties": {
      "section_number": {
        "type": "string"
      },
      "section_title": {
        "type": "string"
      },
      "index_items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "number",
            "title"
          ],
          "properties": {
            "number": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}