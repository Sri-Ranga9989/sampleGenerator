{
  "template_id": "02_toc_image",
  "template_name": "Table of Contents",
  "version": "1.0",

  "canvas": {
    "width": 1920,
    "height": 1080,
    "aspect_ratio": "16:9"
  },

  "background": {
    "asset": "bg_01.png",
    "type": "image"
  },

  "safe_area": {
    "x": 70,
    "y": 40,
    "width": 1240,
    "height": 970
  },

  "regions": {
    "title": {
      "type": "text",
      "role": "slide_title",
      "geometry": "fixed_anchor",
      "x": 420,
      "y": 45,
      "width": 560,
      "height": 65,
      "alignment": "center",
      "vertical_alignment": "middle"
    },

    "left_column": {
      "type": "container",
      "role": "toc_column",
      "geometry": "fixed",
      "x": 90,
      "y": 140,
      "width": 560,
      "height": 875,

      "layout": {
        "type": "vertical_stack",
        "items": "dynamic",
        "preferred_items": 9,
        "maximum_items": 9
      }
    },

    "right_column": {
      "type": "container",
      "role": "toc_column",
      "geometry": "fixed",
      "x": 690,
      "y": 140,
      "width": 620,
      "height": 875,

      "layout": {
        "type": "vertical_stack",
        "items": "dynamic",
        "preferred_items": 9,
        "maximum_items": 9
      }
    }
  },

  "components": {
    "toc_item": {
      "type": "component",
      "role": "toc_item",

      "badge": {
        "type": "shape",
        "shape": "diamond",
        "width": 72,
        "height": 72,
        "fill": "#0D3166",
        "line": {
          "enabled": false
        }
      },

      "number": {
        "type": "text",
        "position": "center",
        "font_weight": "bold",
        "alignment": "center",
        "color": "#FFFFFF"
      },

      "label": {
        "type": "text",
        "x_offset": 96,
        "width": 430,
        "alignment": "left",
        "vertical_alignment": "middle",
        "allow_wrap": true
      }
    }
  },

  "layout": {},

  "typography": {
    "title": {
      "font_weight": "bold",
      "font_size": 32,
      "alignment": "center"
    },

    "toc_label": {
      "font_weight": "bold",
      "font_size": 22,
      "minimum_font_size": 18,
      "maximum_font_size": 22,
      "line_spacing": 1.05
    },

    "toc_number": {
      "font_weight": "bold",
      "font_size": 18
    }
  },

  "spacing": {
    "column_gap": 40,
    "item_gap": 26,
    "badge_to_text": 24,
    "minimum_item_gap": 12
  },

  "constraints": {
    "preferred_items_per_column": 9,
    "maximum_items_per_column": 9,
    "maximum_items_per_slide": 18,

    "text": {
      "allow_wrap": true,
      "maximum_lines_per_item": 2
    },

    "font": {
      "allow_dynamic_reduction": true,
      "minimum_toc_font_size": 18
    },

    "layout": {
      "preserve_column_alignment": true,
      "preserve_badge_size": true,
      "preserve_visual_hierarchy": true
    }
  },

  "overflow": {
    "strategy": [
      "wrap_text",
      "reduce_spacing",
      "reduce_font_size",
      "rebalance_columns",
      "split_into_continuation_slide"
    ],

    "never": [
      "crop_text",
      "overlap_items",
      "extend_into_decoration"
    ]
  },

  "content_model": {
    "type": "table_of_contents",

    "item": {
      "required": [
        "number",
        "title"
      ],

      "properties": {
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    }
  }
}
