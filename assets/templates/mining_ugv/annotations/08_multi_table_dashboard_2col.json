{
  "template_id": "08_multi_table_dashboard_2col",
  "template_name": "Multi-Table Dashboard 2-Column",
  "version": "1.0",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "aspect_ratio": "16:9"
  },
  "background": {
    "asset": "bg_01.png",
    "type": "image"
  },
  "safe_area": {
    "x": 83,
    "y": 48,
    "width": 1754,
    "height": 984
  },
  "regions": {
    "left_column": {
      "type": "container",
      "role": "dashboard_column",
      "geometry": "fixed",
      "x": 107,
      "y": 75,
      "width": 790,
      "height": 820,
      "layout": {
        "type": "vertical_stack",
        "blocks": "dynamic"
      }
    },
    "right_column": {
      "type": "container",
      "role": "dashboard_column",
      "geometry": "fixed",
      "x": 960,
      "y": 75,
      "width": 780,
      "height": 820,
      "layout": {
        "type": "vertical_stack",
        "blocks": "dynamic"
      }
    }
  },
  "components": {
    "heading": {
      "type": "text",
      "role": "dashboard_heading",
      "allow_wrap": true,
      "maximum_lines": 2
    },
    "paragraph": {
      "type": "text",
      "role": "dashboard_paragraph",
      "allow_wrap": true,
      "auto_height": true
    },
    "bullet_list": {
      "type": "list",
      "role": "dashboard_bullet_list",
      "items": "dynamic",
      "allow_wrap": true
    },
    "table": {
      "type": "table",
      "role": "dashboard_table",
      "rows": "dynamic",
      "columns": "dynamic",
      "layout": {
        "auto_row_height": true,
        "auto_column_width": true
      }
    },
    "insight": {
      "type": "text",
      "role": "dashboard_insight",
      "allow_wrap": true,
      "auto_height": true
    },
    "index_list": {
      "type": "list",
      "role": "section_index_list",
      "item_type": "index_item",
      "items": "dynamic"
    },
    "index_item": {
      "type": "component",
      "role": "index_item",
      "allow_wrap": true,
      "maximum_lines": 2
    }
  },
  "typography": {
    "heading": {
      "font_size": 22,
      "minimum_font_size": 18,
      "maximum_font_size": 24,
      "font_weight": "bold"
    },
    "paragraph": {
      "font_size": 20,
      "minimum_font_size": 16,
      "maximum_font_size": 21,
      "font_weight": "normal",
      "line_spacing": 1.05
    },
    "bullet_list": {
      "font_size": 19,
      "minimum_font_size": 16,
      "maximum_font_size": 20,
      "line_spacing": 1.05
    },
    "table_header": {
      "font_size": 19,
      "minimum_font_size": 14,
      "maximum_font_size": 20,
      "font_weight": "bold"
    },
    "table_body": {
      "font_size": 18,
      "minimum_font_size": 13,
      "maximum_font_size": 19
    },
    "table_total": {
      "font_size": 18,
      "minimum_font_size": 13,
      "maximum_font_size": 20,
      "font_weight": "bold"
    }
  },
  "spacing": {
    "column_gap": 63,
    "block_gap": 8,
    "minimum_block_gap": 4,
    "heading_to_table": 8,
    "heading_to_paragraph": 7,
    "paragraph_to_heading": 8,
    "table_to_paragraph": 8,
    "paragraph_to_table": 8,
    "table_to_table": 25,
    "bullet_item_gap": 3
  },
  "constraints": {
    "layout": {
      "column_count": 2,
      "preserve_column_width": true,
      "preserve_column_alignment": true,
      "allow_independent_column_height": true
    },
    "blocks": {
      "allowed": [
        "heading",
        "paragraph",
        "bullet_list",
        "table",
        "insight",
        "index_list"
      ]
    },
    "table": {
      "auto_row_height": true,
      "auto_column_width": true,
      "allow_text_wrap": true,
      "allow_font_reduction": true,
      "minimum_font_size": 13,
      "minimum_row_height": 28
    },
    "text": {
      "allow_wrap": true,
      "auto_height": true,
      "prevent_clipping": true,
      "prevent_overlap": true
    },
    "bullet_list": {
      "allow_wrap": true,
      "auto_height": true,
      "maximum_item_lines": 2
    }
  },
  "overflow": {
    "strategy": [
      "measure_all_blocks",
      "calculate_dynamic_block_heights",
      "reduce_block_spacing",
      "reduce_font_size_within_limits",
      "rebalance_blocks_between_columns",
      "move_remaining_blocks_to_continuation_slide",
      "create_continuation_slide"
    ],
    "continuation_template": "08_multi_table_dashboard_2col",
    "never": [
      "crop_text",
      "overlap_blocks",
      "overlap_tables",
      "shrink_below_minimum_font_size",
      "force_fixed_block_heights"
    ]
  },
  "content_model": {
    "type": "multi_table_dashboard_2col",
    "required": [
      "columns"
    ],
    "properties": {
      "columns": {
        "type": "array",
        "minimum": 1,
        "maximum": 2,
        "items": {
          "type": "object",
          "required": [
            "blocks"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "heading",
                      "paragraph",
                      "bullet_list",
                      "table",
                      "insight",
                      "index_list"
                    ]
                  },
                  "content": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array"
                  },
                  "table": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}